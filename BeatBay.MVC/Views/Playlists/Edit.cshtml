@model BeatBay.DTOs.CreatePlaylistDto

@{
    ViewData["Title"] = "Editar Playlist";
    var playlistId = ViewBag.PlaylistId ?? 0;
}

<style>
    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .edit-playlist-container {
        position: relative;
        min-height: calc(100vh - 80px);
        color: white;
        padding: 0;
        margin: 0;
        background: transparent;
    }

    .playlist-card {
        background: rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 3rem;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
    }

        .playlist-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
        }

    .edit-icon-container {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
        box-shadow: 0 15px 30px rgba(245, 158, 11, 0.4);
        transition: all 0.3s ease;
    }

        .edit-icon-container:hover {
            transform: scale(1.05);
            box-shadow: 0 20px 40px rgba(245, 158, 11, 0.5);
        }

    .form-control {
        color: white !important;
        background: rgba(255, 255, 255, 0.05) !important;
        border: 2px solid rgba(255, 255, 255, 0.15) !important;
        border-radius: 12px !important;
        padding: 15px 20px !important;
        height: 55px !important;
        transition: all 0.3s ease;
        backdrop-filter: blur(5px);
        font-size: 1rem;
    }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.1) !important;
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15) !important;
            transform: translateY(-2px);
        }

        .form-control::placeholder {
            color: rgba(248, 250, 252, 0.5) !important;
        }

    .form-label {
        font-weight: 700 !important;
        color: rgba(248, 250, 252, 0.8) !important;
        margin-bottom: 0.75rem !important;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .btn-primary {
        background: linear-gradient(135deg, #6366f1, #8b5cf6) !important;
        border: none !important;
        border-radius: 30px !important;
        padding: 15px 0 !important;
        font-weight: 700 !important;
        letter-spacing: 1px !important;
        font-size: 1rem !important;
        transition: all 0.3s ease !important;
        box-shadow: 0 6px 20px rgba(99, 102, 241, 0.3) !important;
        text-transform: uppercase;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #5856eb, #7c3aed) !important;
            transform: translateY(-3px) !important;
            box-shadow: 0 12px 30px rgba(99, 102, 241, 0.4) !important;
        }

    .btn-outline-light {
        border: 2px solid rgba(248, 250, 252, 0.3) !important;
        color: rgba(248, 250, 252, 0.9) !important;
        background: transparent !important;
        border-radius: 30px !important;
        padding: 15px 0 !important;
        font-weight: 700 !important;
        letter-spacing: 1px !important;
        font-size: 1rem !important;
        transition: all 0.3s ease !important;
        text-transform: uppercase;
    }

        .btn-outline-light:hover {
            background: rgba(248, 250, 252, 0.1) !important;
            border-color: rgba(248, 250, 252, 0.5) !important;
            color: white !important;
            transform: translateY(-2px) !important;
            box-shadow: 0 8px 25px rgba(248, 250, 252, 0.2) !important;
        }

    .alert {
        border-radius: 12px !important;
        background: rgba(239, 68, 68, 0.15) !important;
        border: 1px solid rgba(239, 68, 68, 0.3) !important;
        color: rgba(248, 250, 252, 0.9) !important;
        backdrop-filter: blur(10px);
        padding: 1rem 1.5rem;
    }

    .content-wrapper {
        padding: 3rem 0;
        display: flex;
        align-items: center;
        min-height: calc(100vh - 80px);
    }

    .page-title {
        font-weight: 800 !important;
        color: white !important;
        font-size: 2.2rem !important;
        text-shadow: 0 2px 15px rgba(0, 0, 0, 0.3);
        margin-bottom: 0;
    }

    .text-danger {
        color: #fca5a5 !important;
        font-size: 0.85rem;
        margin-top: 0.5rem;
        display: block;
    }

    @@media (max-width: 768px) {
        .playlist-card

    {
        padding: 2rem 1.5rem;
        margin: 1rem;
    }

    .content-wrapper {
        padding: 2rem 0;
    }

    .edit-icon-container {
        width: 80px;
        height: 80px;
    }

    .page-title {
        font-size: 1.8rem !important;
    }

    .form-control {
        height: 50px !important;
        padding: 12px 15px !important;
    }

    .btn-primary, .btn-outline-light {
        padding: 12px 0 !important;
        font-size: 0.9rem !important;
    }

    }
</style>

<div class="edit-playlist-container">
    <div class="content-wrapper">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6 col-md-8 col-sm-10">
                    <!-- Tarjeta de edición -->
                    <div class="playlist-card">
                        <!-- Header con icono y título -->
                        <div class="text-center mb-5">
                            <div class="edit-icon-container">
                                <i class="fas fa-edit fa-2x" style="color: white;"></i>
                            </div>
                            <h2 class="page-title">@ViewData["Title"]</h2>
                        </div>

                        <!-- Alertas -->
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger mb-4">
                                <i class="fas fa-exclamation-circle me-2"></i> @ViewBag.Error
                            </div>
                        }

                        <!-- Formulario de edición -->
                        <form asp-action="Edit" asp-route-id="@playlistId" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-5">
                                <label asp-for="Name" class="form-label">Nombre de la Playlist</label>
                                <input asp-for="Name" class="form-control"
                                       placeholder="Mi playlist increíble"
                                       maxlength="150"
                                       required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <!-- Botones de acción -->
                            <div class="d-grid gap-3 mt-5">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-2"></i> Guardar Cambios
                                </button>

                                <a asp-action="Index" class="btn btn-outline-light">
                                    <i class="fas fa-times me-2"></i> Cancelar
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}