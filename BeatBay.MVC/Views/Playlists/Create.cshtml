@model BeatBay.DTOs.CreatePlaylistDto

@{
    ViewData["Title"] = "Crear Playlist";
}

<div class="create-playlist-container" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); min-height: 100vh; color: white;">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <a asp-action="Index" class="btn btn-outline-light rounded-circle" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <h2 class="text-center mb-0" style="color: white; font-weight: 700;">@ViewData["Title"]</h2>
                    <div style="width: 40px;"></div> <!-- Espaciador para alinear -->
                </div>

                <div class="playlist-card" style="background: rgba(255, 255, 255, 0.05); border-radius: 15px; padding: 2rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mb-4" style="border-radius: 10px; background: rgba(239, 68, 68, 0.2); border: none; color: #fca5a5;">
                            <i class="fas fa-exclamation-circle me-2"></i> @ViewBag.Error
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <div class="playlist-cover mb-4" style="height: 200px; background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-music" style="font-size: 3rem; color: rgba(255, 255, 255, 0.3);"></i>
                            </div>

                            <label asp-for="Name" class="form-label" style="font-weight: 600; color: #a0aec0;">NOMBRE DE LA PLAYLIST</label>
                            <input asp-for="Name" class="form-control bg-transparent text-white" style="border: 2px solid rgba(255, 255, 255, 0.1); border-radius: 10px; padding: 12px 15px; height: 50px;"
                                   placeholder="Mi playlist increíble" maxlength="150" required />
                            <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                        </div>

                        <div class="d-grid gap-3 mt-5">
                            <button type="submit" class="btn btn-primary py-3" style="border-radius: 25px; background: linear-gradient(135deg, #6366f1, #8b5cf6); border: none; font-weight: 600; letter-spacing: 0.5px;">
                                <i class="fas fa-plus-circle me-2"></i> CREAR PLAYLIST
                            </button>

                            <a asp-action="Index" class="btn btn-outline-light py-3" style="border-radius: 25px; border: 2px solid rgba(255, 255, 255, 0.2); font-weight: 600;">
                                <i class="fas fa-times me-2"></i> CANCELAR
                            </a>
                        </div>
                    </form>
                </div>

                <div class="text-center mt-4">
                    <p class="text-muted" style="font-size: 0.9rem;">
                        <i class="fas fa-info-circle me-1"></i> Puedes agregar canciones después de crear la playlist
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Efecto de cambio de color para la portada de la playlist
        const cover = document.querySelector('.playlist-cover');
        const nameInput = document.querySelector('#Name');

        // Gradientes aleatorios
        const gradients = [
            'linear-gradient(135deg, #6366f1, #8b5cf6)',
            'linear-gradient(135deg, #10b981, #059669)',
            'linear-gradient(135deg, #f59e0b, #d97706)',
            'linear-gradient(135deg, #ef4444, #dc2626)',
            'linear-gradient(135deg, #3b82f6, #2563eb)'
        ];

        // Cambiar gradiente cuando el usuario escribe
        nameInput.addEventListener('input', function() {
            if(this.value.length > 0) {
                const hash = this.value.split('').reduce((a, b) => {
                    a = ((a << 5) - a) + b.charCodeAt(0);
                    return a & a;
                }, 0);

                const gradientIndex = Math.abs(hash) % gradients.length;
                cover.style.background = gradients[gradientIndex];
            }
        });
    </script>
}

<style>
    .create-playlist-container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .form-control:focus {
        background-color: rgba(255, 255, 255, 0.1) !important;
        border-color: #6366f1 !important;
        box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25) !important;
        color: white !important;
    }

    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.4) !important;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #5856eb, #7c3aed) !important;
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3) !important;
    }

    .btn-outline-light:hover {
        background: rgba(255, 255, 255, 0.1) !important;
        border-color: rgba(255, 255, 255, 0.3) !important;
    }

    .playlist-cover {
        transition: all 0.5s ease;
    }
</style>