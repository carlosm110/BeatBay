@model List<BeatBay.DTOs.PlanSubscriptionDto>
@{
    ViewData["Title"] = "Subscription History";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Título principal de la página -->
            <h2 class="mb-4">
                <i class="fas fa-history me-2"></i>
                Subscription History
            </h2>

            <!-- Mensaje de error desde TempData o ViewBag -->
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-warning alerta-historial">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    @ViewBag.ErrorMessage
                </div>
            }

            @if (Model.Any())
            {
                <!-- Filas de estadísticas resumidas -->
                <div class="row mb-4">
                    <!-- Total de suscripciones -->
                    <div class="col-md-3">
                        <div class="card tarjeta-estadistica bg-primary text-white">
                            <div class="card-body text-center">
                                <i class="fas fa-clipboard-list fa-3x mb-3"></i>
                                <h3 class="display-4">@Model.Count</h3>
                                <p class="mb-0 text-uppercase">Total Subscriptions</p>
                            </div>
                        </div>
                    </div>
                    <!-- Suscripciones activas -->
                    <div class="col-md-3">
                        <div class="card tarjeta-estadistica bg-success text-white">
                            <div class="card-body text-center">
                                <i class="fas fa-check-circle fa-3x mb-3"></i>
                                <h3 class="display-4">@Model.Count(s => s.IsActive)</h3>
                                <p class="mb-0 text-uppercase">Active</p>
                            </div>
                        </div>
                    </div>
                    <!-- Suscripciones canceladas -->
                    <div class="col-md-3">
                        <div class="card tarjeta-estadistica bg-warning text-white">
                            <div class="card-body text-center">
                                <i class="fas fa-times-circle fa-3x mb-3"></i>
                                <h3 class="display-4">@Model.Count(s => !s.IsActive)</h3>
                                <p class="mb-0 text-uppercase">Canceled</p>
                            </div>
                        </div>
                    </div>
                    <!-- Monto total invertido -->
                    <div class="col-md-3">
                        <div class="card tarjeta-estadistica bg-info text-white">
                            <div class="card-body text-center">
                                <i class="fas fa-dollar-sign fa-3x mb-3"></i>
                                <h3 class="display-4">$@Model.Sum(s => s.PriceUSD).ToString("F2")</h3>
                                <p class="mb-0 text-uppercase">Total Invested</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabla detallada de historial de suscripciones -->
                <div class="card tabla-historial shadow-sm">
                    <div class="card-header bg-primary text-white encabezado-tabla">
                        <h5 class="mb-0">
                            <i class="fas fa-table me-2"></i>
                            Detailed History
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 cuerpo-tabla">
                                <thead class="tabla-oscura">
                                    <tr>
                                        <th>Plan</th>
                                        <th>Price</th>
                                        <th>Connections</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Duration</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sub in Model.OrderByDescending(s => s.StartDate))
                                    {
                                        <!-- Fila de suscripción con color según estado -->
                                        <tr class="@(sub.IsActive ? "fila-activa" : "fila-inactiva")">
                                            <!-- Columna plan con icono -->
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="plan-icon me-3">
                                                        <i class="fas fa-crown text-warning"></i>
                                                    </div>
                                                    <div>
                                                        <strong>@sub.PlanName</strong><br />
                                                        <small class="text-muted">ID: #@sub.Id</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <!-- Columna precio con badge -->
                                            <td>
                                                <span class="badge badge-precio">
                                                    $@sub.PriceUSD.ToString("F2") USD
                                                </span>
                                            </td>
                                            <!-- Columna conexiones con progress bar -->
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="progress barra-conexiones me-2">
                                                        @{
                                                            var porcentaje = sub.MaxConnections > 0 ? (sub.UsedConnections * 100 / sub.MaxConnections) : 0;
                                                        }
                                                        <div class="progress-bar bg-info"
                                                             role="progressbar"
                                                             style="width: @porcentaje%">
                                                        </div>
                                                    </div>
                                                    <span class="badge badge-conexiones">
                                                        @sub.UsedConnections/@sub.MaxConnections
                                                    </span>
                                                </div>
                                            </td>
                                            <!-- Fecha de inicio -->
                                            <td>
                                                <div class="fecha-info">
                                                    <i class="fas fa-calendar text-success me-1"></i>
                                                    @sub.StartDate.ToString("dd/MM/yyyy HH:mm")
                                                </div>
                                            </td>
                                            <!-- Fecha de fin -->
                                            <td>
                                                <div class="fecha-info">
                                                    <i class="fas fa-calendar-times text-danger me-1"></i>
                                                    @sub.EndDate.ToString("dd/MM/yyyy HH:mm")
                                                </div>
                                            </td>
                                            <!-- Duración -->
                                            <td>
                                                @{
                                                    var dur = sub.EndDate - sub.StartDate;
                                                    var textoDur = dur.Days > 0 ? $"{dur.Days} days" : "< 1 day";
                                                }
                                                <span class="badge badge-duracion">
                                                    <i class="fas fa-hourglass-half me-1"></i>
                                                    @textoDur
                                                </span>
                                            </td>
                                            <!-- Estado actual -->
                                            <td>
                                                @if (sub.IsActive)
                                                {
                                                    <span class="badge bg-success badge-estado">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary badge-estado">
                                                        Canceled
                                                    </span>
                                                }
                                            </td>
                                            <!-- Acciones: ver detalles o gestionar -->
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("Details", new { id = sub.Id })"
                                                       class="btn btn-detalles btn-sm">
                                                        <i class="fas fa-eye me-1"></i>
                                                        View Details
                                                    </a>
                                                    @if (sub.IsActive)
                                                    {
                                                        <a href="@Url.Action("Index")"
                                                           class="btn btn-gestionar btn-sm">
                                                            <i class="fas fa-cog me-1"></i>
                                                            Manage
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Mensaje cuando no hay historial -->
                <div class="card estado-vacio">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-history texto-muted mb-4 icono-vacio"></i>
                        <h3 class="texto-muted mb-3">No subscription history</h3>
                        <p class="texto-muted mb-4">
                            You don't have any subscriptions in your history yet.
                        </p>
                        <a href="@Url.Action("Purchase")" class="btn btn-comprar-plan btn-lg">
                            <i class="fas fa-shopping-cart me-2"></i>
                            Purchase your first plan
                        </a>
                    </div>
                </div>
            }

            <!-- Botones de navegación al final -->
            <div class="row mt-4">
                <div class="col-12 text-center">
                    <div class="btn-group grupo-botones" role="group">
                        <a href="@Url.Action("Index")" class="btn btn-volver-planes btn-lg">
                            <i class="fas fa-arrow-left me-2"></i>
                            Back to My Plans
                        </a>
                        <a href="@Url.Action("Purchase")" class="btn btn-comprar-plan btn-lg">
                            <i class="fas fa-plus me-2"></i>
                            Purchase New Plan
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Variables globales en español */
    :root {
        --color-primario: #6366f1;
        --color-primario-hover: #8b5cf6;
        --color-exito: #10b981;
        --color-alerta: #f59e0b;
        --color-peligro: #ef4444;
        --fondo-gradiente-principal: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --fondo-claro: #f8fafc;
        --texto-oscuro: #1f2937;
        --sombra-clara: rgba(0, 0, 0, 0.1);
    }

    /* Fondo general y color de texto */
    body {
        background: var(--fondo-gradiente-principal);
        color: var(--texto-oscuro);
    }

    /* Botón para volver al panel de planes */
    .btn-volver-planes {
        background-color: rgba(255,255,255,0.7);
        border-color: #fff;
        color: var(--texto-oscuro);
    }

        .btn-volver-planes:hover {
            background-color: #fff;
            border-color: var(--color-primario);
            color: var(--color-primario);
        }

    /* Botón para comprar un plan */
    .btn-comprar-plan {
        background-color: var(--color-primario);
        border-color: var(--color-primario);
        color: #fff;
    }

        .btn-comprar-plan:hover {
            background-color: var(--color-primario-hover);
            border-color: var(--color-primario-hover);
        }

    /* Tarjetas de estadística */
    .tarjeta-estadistica {
        border: none;
        border-radius: 15px;
        box-shadow: 0 2px 4px var(--sombra-clara);
    }

    /* Tabla de historial */
    .tabla-historial {
        border-radius: 15px;
        overflow: hidden;
    }

    .encabezado-tabla {
        background: var(--color-primario);
    }

    .tabla-oscura th {
        background: var(--color-primario);
        color: #fff;
    }

    /* Estilo de filas según estado */
    .fila-activa {
        background-color: rgba(16,185,129,0.1);
    }

    .fila-inactiva {
        background-color: rgba(245,158,11,0.1);
    }

    /* Badge de precio */
    .badge-precio {
        background-color: var(--color-primario);
        color: #fff;
        padding: 0.5em 1em;
        border-radius: 0.5rem;
    }

    /* Barra de conexiones */
    .barra-conexiones {
        height: 20px;
        border-radius: 10px;
    }

    /* Badges de conexiones y duración */
    .badge-conexiones {
        background: var(--color-exito);
        color: #fff;
    }

    .badge-duracion {
        background: var(--fondo-claro);
        color: var(--texto-oscuro);
    }

    .badge-estado {
        padding: 0.3em 0.6em;
        border-radius: 0.5rem;
    }

    /* Iconos de fecha */
    .fecha-info i {
        margin-right: 0.3em;
    }

    /* Estado vacío */
    .estado-vacio {
        border: none;
        box-shadow: 0 2px 4px var(--sombra-clara);
    }

    .icono-vacio {
        font-size: 5rem;
        color: rgba(0,0,0,0.2);
    }

    /* Botones de detalles y gestionar dentro de la tabla */
    .btn-detalles {
        background: transparent;
        border: 1px solid var(--color-primario);
        color: var(--color-primario);
    }

    .btn-gestionar {
        background: transparent;
        border: 1px solid var(--color-primario-hover);
        color: var(--color-primario-hover);
    }
</style>