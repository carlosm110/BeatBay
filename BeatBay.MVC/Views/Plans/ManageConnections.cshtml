@model BeatBay.DTOs.UserPlanStatusDto
@{
    ViewData["Title"] = "Manage Connections";
}

<div class="container mt-4">
    <h2 class="mb-4 text-gradient">
        <i class="fas fa-users me-2"></i> Manage Connections
    </h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success custom-alert alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger custom-alert alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <nav aria-label="breadcrumb" class="custom-breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Plans")" class="breadcrumb-link">My Plans</a></li>
            <li class="breadcrumb-item active" aria-current="page">Manage Connections</li>
        </ol>
    </nav>

    @* Estado del plan *@
    @if (Model.CurrentSubscription != null)
    {
        <div class="card mb-4 shadow-custom">
            <div class="card-header gradient-header">
                <i class="fas fa-info-circle me-2"></i> Plan Status
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-3">
                        <h5 class="mb-0">@Model.CurrentSubscription.PlanName</h5>
                        <p class="text-muted mb-0">Current plan</p>
                    </div>
                    <div class="col-md-3 text-center">
                        <h4 class="mb-0">
                            <span class="badge badge-primary">
                                @Model.CurrentSubscription.UsedConnections/@Model.CurrentSubscription.MaxConnections
                            </span>
                        </h4>
                        <p class="text-muted mb-0">Connections used</p>
                    </div>
                    <div class="col-md-3">
                        <div class="progress custom-progress">
                            <div class="progress-bar progress-bar-custom" role="progressbar"
                                 style="width:@(((double)Model.CurrentSubscription.UsedConnections / Model.CurrentSubscription.MaxConnections) * 100)%">
                            </div>
                        </div>
                        <small class="text-muted">Connection usage</small>
                    </div>
                    <div class="col-md-3 text-end">
                        @{
                            var avail = Model.CurrentSubscription.MaxConnections - Model.CurrentSubscription.UsedConnections;
                        }
                        <h5 class="mb-0 text-success">@avail</h5>
                        <p class="text-muted mb-0">Available</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        @* Usuarios conectados *@
        <div class="col-md-8 mb-4">
            <div class="card shadow-custom">
                <div class="card-header gradient-header">
                    <i class="fas fa-user-check me-2"></i> Connected Users
                </div>
                <div class="card-body">
                    @if (Model.CurrentSubscription.ConnectedUsers.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover custom-table">
                                <thead class="table-dark-custom">
                                    <tr>
                                        <th>ID</th>
                                        <th>User</th>
                                        <th>Name</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in Model.CurrentSubscription.ConnectedUsers)
                                    {
                                        <tr class="subscription-row">
                                            <td><strong>#@u.Id</strong></td>
                                            <td><strong>@u.UserName</strong></td>
                                            <td>
                                                @(string.IsNullOrEmpty(u.Name) ? "<span class=\"text-muted\">Not specified</span>" : u.Name)
                                            </td>
                                            <td>
                                                <span class="badge badge-success">
                                                    <i class="fas fa-check me-1"></i> Connected
                                                </span>
                                            </td>
                                            <td>
                                                <form method="post" action="@Url.Action("RemoveConnection","Plans")" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="childUserId" value="@u.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger custom-btn"
                                                            onclick="return confirm('Are you sure you want to remove this user?');">
                                                        <i class="fas fa-user-times me-1"></i> Remove
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted empty-state">
                            <i class="fas fa-user-slash fa-3x mb-3"></i>
                            <div>No connected users</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Agregar conexión *@
        <div class="col-md-4 mb-4">
            <div class="card shadow-custom">
                <div class="card-header gradient-header">
                    <i class="fas fa-user-plus me-2"></i> Add User by ID
                </div>
                @{
                    var canAdd = Model.CurrentSubscription.UsedConnections < Model.CurrentSubscription.MaxConnections;
                }
                @if (canAdd)
                {
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="searchUsername" class="form-label">Search User</label>
                            <div class="input-group">
                                <input type="text" id="searchUsername" class="form-control"
                                       placeholder="Enter username..." />
                                <button type="button" class="btn btn-primary custom-btn" onclick="searchUsers()">
                                    <i class="fas fa-search me-1"></i> Search
                                </button>
                            </div>
                            <div class="form-text">Enter username to search</div>
                        </div>

                        <div id="searchResults" class="list-group mb-3" style="display:none;">
                            <!-- Results will be populated here -->
                        </div>

                        <form method="post" action="@Url.Action("AddConnection","Plans")" id="addConnectionForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="childUserId" name="childUserId" required />
                            <button type="submit" class="btn btn-success w-100 custom-btn" style="display:none;" id="addButton">
                                <i class="fas fa-plus me-2"></i> Add User
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="card-body text-center empty-state">
                        <i class="fas fa-exclamation-triangle fa-2x mb-2 text-warning"></i>
                        <p class="text-muted">Connection limit reached</p>
                    </div>
                }
            </div>

            <div class="card mt-3 shadow-custom">
                <div class="card-header gradient-header">
                    <i class="fas fa-lightbulb me-2"></i> Tips
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Immediate access</li>
                        <li class="mb-2"><i class="fas fa-user-times text-primary me-2"></i>Remove at any time</li>
                        <li class="mb-2"><i class="fas fa-users text-info me-2"></i>Independent personal library</li>
                        <li><i class="fas fa-hashtag text-warning me-2"></i>Only need user ID</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    @* FAQ *@
    <div class="card mb-4 shadow-custom">
        <div class="card-header gradient-header">
            <i class="fas fa-question-circle me-2"></i> Frequently Asked Questions
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="section-title"><i class="fas fa-user-friends text-primary me-2"></i>How do connections work?</h6>
                    <p class="text-muted">You share access to your plan while maintaining independent profiles.</p>
                    <h6 class="section-title"><i class="fas fa-hashtag text-success me-2"></i>Where do I find the ID?</h6>
                    <p class="text-muted">Users can find their ID in their profile or settings.</p>
                </div>
                <div class="col-md-6">
                    <h6 class="section-title"><i class="fas fa-times-circle text-danger me-2"></i>What happens when removing?</h6>
                    <p class="text-muted">The user loses access but keeps their personal library.</p>
                    <h6 class="section-title"><i class="fas fa-chart-line text-warning me-2"></i>Can I see activity?</h6>
                    <p class="text-muted">Only who is connected is visible, not detailed activity.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mb-4">
        <a href="@Url.Action("Index", "Plans")" class="btn btn-secondary custom-btn">
            <i class="fas fa-arrow-left me-1"></i> Back to Plans
        </a>
    </div>
</div>

<style>
    :root {
        --primary-color: #6366f1;
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        --success-color: #10b981;
        --success-dark: #059669;
        --warning-color: #f59e0b;
        --danger-color: #ef4444;
        --danger-dark: #dc2626;
        --bg-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --light-gray: #f8fafc;
        --medium-gray: #64748b;
        --dark-gray: #1f2937;
        --shadow-light: rgba(0, 0, 0, 0.1);
        --transparency-05: rgba(255, 255, 255, 0.05);
        --transparency-1: rgba(255, 255, 255, 0.1);
        --transparency-2: rgba(255, 255, 255, 0.2);
    }

    body {
        background: var(--bg-gradient);
        min-height: 100vh;
        color: var(--dark-gray);
    }

    .text-gradient {
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 700;
    }

    .custom-alert {
        border-radius: 12px;
        backdrop-filter: blur(10px);
        border: none;
    }

    .alert-success {
        background: rgba(16, 185, 129, 0.15);
        border-left: 4px solid var(--success-color);
        color: #065f46;
    }

    .alert-danger {
        background: rgba(239, 68, 68, 0.15);
        border-left: 4px solid var(--danger-color);
        color: #991b1b;
    }

    .custom-breadcrumb {
        background: rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        padding: 12px 20px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .breadcrumb-link {
        color: white;
        text-decoration: none;
        font-weight: 500;
        opacity: 0.8;
    }

        .breadcrumb-link:hover {
            color: white;
            text-decoration: underline;
            opacity: 1;
        }

    .shadow-custom {
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }

    .card {
        border: none;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        }

    .gradient-header {
        background: var(--primary-gradient);
        border-radius: 16px 16px 0 0;
        border: none;
        color: white;
        padding: 1.25rem 1.5rem;
    }

    .custom-table {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        border: none;
    }

    .table-dark-custom {
        background: var(--dark-gray);
        color: white;
    }

        .table-dark-custom th {
            border: none;
            padding: 16px;
            font-weight: 600;
            font-size: 0.9rem;
        }

    .subscription-row {
        border-left: 4px solid transparent;
        transition: all 0.3s ease;
    }

        .subscription-row:hover {
            background-color: rgba(99, 102, 241, 0.05) !important;
            border-left-color: var(--primary-color);
            transform: translateX(4px);
        }

    .custom-progress {
        height: 10px;
        border-radius: 20px;
        background: var(--light-gray);
    }

    .progress-bar-custom {
        background: var(--primary-gradient);
        border-radius: 20px;
        transition: width 0.6s ease;
    }

    .badge {
        font-size: 0.85rem;
        border-radius: 20px;
        padding: 8px 16px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .badge-primary {
        background: var(--primary-gradient);
        color: white;
    }

    .badge-success {
        background: linear-gradient(135deg, var(--success-color) 0%, var(--success-dark) 100%);
        color: white;
    }

    .badge-warning {
        background: var(--warning-color);
        color: white;
    }

    .badge-info {
        background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
        color: white;
    }

    .badge-secondary {
        background: var(--medium-gray);
        color: white;
    }

    .custom-btn {
        border-radius: 12px;
        font-weight: 500;
        transition: all 0.3s ease;
        border: 2px solid transparent;
        padding: 10px 20px;
        font-size: 0.9rem;
    }

        .custom-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        }

    .btn-outline-danger {
        border-color: var(--danger-color);
        color: var(--danger-color);
    }

        .btn-outline-danger:hover {
            background: var(--danger-color);
            color: white;
        }

    .btn-primary {
        background: var(--primary-gradient);
        border: none;
        color: white;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #5856eb 0%, #7c3aed 100%);
            color: white;
            box-shadow: 0 8px 24px rgba(99, 102, 241, 0.3);
        }

    .btn-secondary {
        background: var(--medium-gray);
        color: white;
    }

        .btn-secondary:hover {
            background: var(--dark-gray);
            color: white;
        }

    .empty-state {
        padding: 2rem 0;
    }

    .section-title {
        color: var(--primary-color);
        font-weight: 600;
        font-size: 1rem;
        margin-bottom: 0.5rem;
    }

    .list-group-item {
        transition: all 0.3s ease;
        border-radius: 8px;
        margin-bottom: 8px;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

        .list-group-item:hover {
            background-color: rgba(99, 102, 241, 0.1);
            border-color: rgba(99, 102, 241, 0.2);
        }

    .form-control {
        border-radius: 12px;
        padding: 10px 15px;
        border: 1px solid rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.25rem rgba(99, 102, 241, 0.25);
        }

    .input-group .btn {
        border-radius: 0 12px 12px 0;
    }

    .input-group .form-control {
        border-radius: 12px 0 0 12px;
    }

    @@media (max-width: 768px) {
        .table-responsive {
            font-size: 0.9rem;
        }

        .badge {
            font-size: 0.75rem;
            padding: 6px 12px;
        }

        .custom-btn {
            font-size: 0.8rem;
            padding: 8px 16px;
        }

        .gradient-header {
            padding: 1rem;
        }

        .card-body {
            padding: 1rem;
        }
    }
</style>

@section Scripts {
    <script>
        async function searchUsers() {
            const username = document.getElementById('searchUsername').value;
            if (!username) return;

            try {
                const response = await fetch(`/Plans/SearchUsers?username=${encodeURIComponent(username)}`);
                const users = await response.json();

                const resultsDiv = document.getElementById('searchResults');
                resultsDiv.innerHTML = '';

                if (users.length === 0) {
                    resultsDiv.innerHTML = '<div class="alert alert-info">No users found</div>';
                } else {
                    users.forEach(user => {
                        const button = document.createElement('button');
                        button.className = 'list-group-item list-group-item-action';
                        button.type = 'button';
                        button.innerHTML = `
                            <strong>${user.userName}</strong>
                            ${user.name ? `<br><small class="text-muted">${user.name}</small>` : ''}
                        `;
                        button.onclick = () => selectUser(user);
                        resultsDiv.appendChild(button);
                    });
                }

                resultsDiv.style.display = 'block';
            } catch (error) {
                console.error('Error:', error);
                alert('Error searching users');
            }
        }

        function selectUser(user) {
            document.getElementById('searchUsername').value = user.userName;
            document.getElementById('childUserId').value = user.id;
            document.getElementById('searchResults').style.display = 'none';
            document.getElementById('addButton').style.display = 'block';
        }
    </script>
}