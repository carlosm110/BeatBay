<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reproductor BeatBay</title>
    <style>
        :root {
            --primary-color: #6c5ce7;
            --secondary-color: #a29bfe;
            --dark-color: #2d3436;
            --light-color: #f5f6fa;
            --text-color: #636e72;
            --highlight-color: #00cec9;
            --card-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
        }

        /* Barra de navegación superior */
        .top-navbar {
            background-color: rgba(0, 0, 0, 0.8);
            height: 60px;
            display: flex;
            align-items: center;
            padding: 0 20px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            backdrop-filter: blur(10px);
        }

        .nav-logo {
            color: white;
            font-weight: bold;
            font-size: 1.5em;
            margin-right: 30px;
        }

        .nav-items {
            display: flex;
            gap: 20px;
        }

        .nav-item {
            color: white;
            text-decoration: none;
            font-weight: 500;
            padding: 8px 12px;
            border-radius: 4px;
            transition: background-color 0.2s;
        }

            .nav-item:hover {
                background-color: rgba(255, 255, 255, 0.1);
            }

        /* Contenedor principal */
        .main-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 100px 20px 120px; /* Espacio para las barras */
        }

        /* Barra de reproducción inferior */
        .player-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 80px;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            padding: 0 20px;
            z-index: 1000;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .player-info {
            display: flex;
            align-items: center;
            gap: 15px;
            width: 250px;
        }

        .player-album-art {
            width: 50px;
            height: 50px;
            background: var(--primary-color);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2em;
        }

        .player-track-info {
            flex: 1;
            min-width: 0;
        }

        .player-track-title {
            font-weight: 600;
            font-size: 0.9em;
            color: white;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 2px;
        }

        .player-track-artist {
            font-size: 0.8em;
            color: var(--secondary-color);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .player-controls {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .player-main-controls {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .player-btn {
            background: none;
            border: none;
            color: white;
            font-size: 1.2em;
            cursor: pointer;
            padding: 8px;
            border-radius: 50%;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .player-btn:hover {
                background: rgba(255, 255, 255, 0.1);
            }

        .player-play-btn {
            background: white;
            color: black;
            width: 40px;
            height: 40px;
        }

            .player-play-btn:hover {
                transform: scale(1.05);
            }

        .player-progress-container {
            width: 100%;
            max-width: 500px;
        }

        .player-progress-bar {
            width: 100%;
            height: 4px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 2px;
            overflow: hidden;
            cursor: pointer;
        }

        .player-progress-fill {
            height: 100%;
            background: var(--primary-color);
            width: 0%;
            transition: width 0.1s ease;
        }

        .player-time-display {
            display: flex;
            justify-content: space-between;
            font-size: 0.7em;
            color: rgba(255, 255, 255, 0.7);
            margin-top: 5px;
        }

        .player-extra-controls {
            display: flex;
            align-items: center;
            gap: 15px;
            width: 250px;
            justify-content: flex-end;
        }

        .player-volume-slider {
            width: 100px;
            height: 4px;
            -webkit-appearance: none;
            appearance: none;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 2px;
            outline: none;
        }

            .player-volume-slider::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 12px;
                height: 12px;
                background: white;
                border-radius: 50%;
                cursor: pointer;
                transition: all 0.2s ease;
            }

                .player-volume-slider::-webkit-slider-thumb:hover {
                    transform: scale(1.2);
                }

        /* Reproductor principal */
        .music-player {
            background: white;
            border-radius: 25px;
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: var(--card-shadow);
            transition: all 0.3s ease;
            position: relative;
        }

            .music-player:hover {
                box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
                transform: translateY(-2px);
            }

        .album-art {
            width: 250px;
            height: 250px;
            background: linear-gradient(135deg, var(--primary-color), var(--highlight-color));
            border-radius: 20px;
            margin: 0 auto 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4em;
            color: white;
            box-shadow: 0 10px 30px rgba(108, 92, 231, 0.3);
            position: relative;
            overflow: hidden;
        }

            .album-art::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);
                transform: rotate(45deg);
                transition: all 0.6s ease;
            }

        .music-player.playing .album-art::before {
            animation: shine 2s infinite;
        }

        @@keyframes shine {
            0%

        {
            transform: translateX(-100%) translateY(-100%) rotate(45deg);
        }

        50% {
            transform: translateX(0%) translateY(0%) rotate(45deg);
        }

        100% {
            transform: translateX(100%) translateY(100%) rotate(45deg);
        }

        }

        .song-info {
            text-align: center;
            margin-bottom: 35px;
        }

        .song-title {
            font-size: 1.8em;
            font-weight: 700;
            margin-bottom: 10px;
            color: var(--dark-color);
            line-height: 1.3;
        }

        .artist-name {
            color: var(--text-color);
            font-size: 1.1em;
            font-weight: 500;
        }

        .controls {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 40px 0;
            gap: 25px;
        }

        .control-btn {
            background: var(--light-color);
            color: var(--text-color);
            border: none;
            border-radius: 50%;
            width: 55px;
            height: 55px;
            font-size: 1.3em;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .control-btn:hover {
                background: #e0e0e0;
                transform: scale(1.05);
            }

        .play-btn {
            background: var(--primary-color);
            color: white;
            width: 80px;
            height: 80px;
            font-size: 2em;
            box-shadow: 0 8px 25px rgba(108, 92, 231, 0.4);
        }

            .play-btn:hover {
                background: var(--secondary-color);
                transform: scale(1.08);
                box-shadow: 0 10px 30px rgba(108, 92, 231, 0.6);
            }

            .play-btn:active {
                transform: scale(0.95);
            }

        .loop-btn.active {
            background: var(--highlight-color);
            color: white;
            box-shadow: 0 5px 15px rgba(0, 206, 201, 0.3);
        }

        .progress-container {
            margin: 30px 0;
        }

        .progress-bar {
            width: 100%;
            height: 8px;
            background: #f0f0f0;
            border-radius: 4px;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
        }

            .progress-bar:hover {
                height: 10px;
            }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary-color), var(--highlight-color));
            width: 0%;
            transition: width 0.1s ease;
            border-radius: 4px;
            position: relative;
        }

            .progress-fill::after {
                content: '';
                position: absolute;
                right: -6px;
                top: 50%;
                transform: translateY(-50%);
                width: 14px;
                height: 14px;
                background: white;
                border-radius: 50%;
                border: 3px solid var(--primary-color);
                opacity: 0;
                transition: opacity 0.2s ease;
            }

        .progress-bar:hover .progress-fill::after {
            opacity: 1;
        }

        .time-display {
            display: flex;
            justify-content: space-between;
            font-size: 0.9em;
            margin-top: 12px;
            color: var(--text-color);
            font-weight: 600;
        }

        .volume-container {
            display: flex;
            align-items: center;
            gap: 15px;
            margin: 25px 0;
            padding: 0 10px;
        }

        .volume-icon {
            font-size: 1.2em;
            color: var(--text-color);
        }

        .volume-slider {
            flex: 1;
            height: 6px;
            -webkit-appearance: none;
            appearance: none;
            background: #f0f0f0;
            border-radius: 5px;
            outline: none;
        }

            .volume-slider::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 18px;
                height: 18px;
                background: var(--primary-color);
                border-radius: 50%;
                cursor: pointer;
                transition: all 0.2s ease;
                box-shadow: 0 2px 6px rgba(0,0,0,0.2);
            }

                .volume-slider::-webkit-slider-thumb:hover {
                    transform: scale(1.2);
                    background: var(--highlight-color);
                }

        .stats-container {
            display: flex;
            justify-content: space-between;
            margin-top: 25px;
            gap: 15px;
        }

        .stat-item {
            background: var(--light-color);
            padding: 12px 20px;
            border-radius: 15px;
            text-align: center;
            flex: 1;
        }

        .stat-value {
            font-weight: 700;
            font-size: 1.1em;
            color: var(--dark-color);
            margin-bottom: 2px;
        }

        .stat-label {
            font-size: 0.8em;
            color: var(--text-color);
        }

        .status {
            text-align: center;
            margin-top: 20px;
            font-size: 0.9em;
            color: var(--highlight-color);
            font-weight: 600;
            height: 20px;
        }

        /* Animaciones mejoradas */
        @@keyframes wave {
            0%, 100%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.03);
        }

        }

        @@keyframes pulse {
            0%, 100%

        {
            opacity: 1;
        }

        50% {
            opacity: 0.7;
        }

        }

        .playing .play-btn {
            animation: wave 2s infinite ease-in-out;
        }

        .playing .album-art {
            animation: pulse 3s infinite ease-in-out;
        }

        /* Responsivo */
        @@media (max-width: 480px) {
            .music-player

        {
            padding: 25px;
        }

        .album-art {
            width: 200px;
            height: 200px;
            font-size: 3em;
        }

        .song-title {
            font-size: 1.5em;
        }

        }
    </style>
</head>
<body>
    <!-- Barra de navegación superior -->
    <nav class="top-navbar">
        <div class="nav-logo">BeatBay</div>
        <div class="nav-items">
            <a href="https://localhost:7194" class="nav-item">Home</a>
            <a href="https://localhost:7194/Songs" class="nav-item">Songs</a>
            <a href="https://localhost:7194/Playlists" class="nav-item">Playlists</a>
            <a href="https://localhost:7194/ArtistStatistics" class="nav-item">Artist Statistics</a>
        </div>
    </nav>

    <!-- Contenido principal -->
    <div class="main-container">
        <div class="music-player" id="playerContainer">
            <div class="album-art" id="albumArt">🎵</div>

            <div class="song-info">
                <div class="song-title" id="songTitle">Título de la canción</div>
                <div class="artist-name" id="artistName">Artista</div>
            </div>

            <div class="controls">
                <button class="control-btn" id="prevBtn" title="Anterior">⏮️</button>
                <button class="control-btn play-btn" id="playBtn">▶️</button>
                <button class="control-btn" id="nextBtn" title="Siguiente">⏭️</button>
                <button class="control-btn loop-btn" id="loopBtn" title="Repetir canción">🔁</button>
            </div>

            <div class="progress-container">
                <div class="progress-bar" id="progressBar">
                    <div class="progress-fill" id="progressFill"></div>
                </div>
                <div class="time-display">
                    <span id="currentTime">0:00</span>
                    <span id="totalTime">0:00</span>
                </div>
            </div>

            <div class="volume-container">
                <span class="volume-icon">🔊</span>
                <input type="range" class="volume-slider" id="volumeSlider" min="0" max="1" step="0.1" value="0.7">
            </div>

            <div class="stats-container">
                <div class="stat-item">
                    <div class="stat-value" id="playCount">0</div>
                    <div class="stat-label">Reproducciones</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="playTime">0:00</div>
                    <div class="stat-label">Tiempo reproducido</div>
                </div>
            </div>

            <div class="status" id="status"></div>
        </div>
    </div>

    <!-- Barra de reproducción inferior -->
    <div class="player-bar">
        <div class="player-info">
            <div class="player-album-art" id="playerAlbumArt">🎵</div>
            <div class="player-track-info">
                <div class="player-track-title" id="playerTrackTitle">Selecciona una canción</div>
                <div class="player-track-artist" id="playerTrackArtist">BeatBay</div>
            </div>
        </div>

        <div class="player-controls">
            <div class="player-main-controls">
                <button class="player-btn" id="playerPrevBtn" title="Anterior">⏮️</button>
                <button class="player-btn player-play-btn" id="playerPlayBtn">▶️</button>
                <button class="player-btn" id="playerNextBtn" title="Siguiente">⏭️</button>
            </div>
            <div class="player-progress-container">
                <div class="player-progress-bar" id="playerProgressBar">
                    <div class="player-progress-fill" id="playerProgressFill"></div>
                </div>
                <div class="player-time-display">
                    <span id="playerCurrentTime">0:00</span>
                    <span id="playerTotalTime">0:00</span>
                </div>
            </div>
        </div>

        <div class="player-extra-controls">
            <button class="player-btn" id="playerLoopBtn" title="Repetir">🔁</button>
            <input type="range" class="player-volume-slider" id="playerVolumeSlider" min="0" max="1" step="0.1" value="0.7">
        </div>
    </div>

    <audio id="audioPlayer" preload="metadata"></audio>

    <script>
        class BeatBayPlayer {
            constructor() {
                this.audio = document.getElementById('audioPlayer');
                this.currentSong = null;
                this.isPlaying = false;
                this.hasStartedPlaying = false;
                this.isLooping = false;
                this.playStartTime = 0;
                this.totalPlayedTime = 0;
                this.currentSessionTime = 0;
                this.playCountRegistered = false;
                this.playTimeThreshold = 10; // 10 segundos mínimos para contar reproducción

                this.initializeElements();
                this.attachEventListeners();
            }

            initializeElements() {
                // Controles principales
                this.playBtn = document.getElementById('playBtn');
                this.loopBtn = document.getElementById('loopBtn');
                this.prevBtn = document.getElementById('prevBtn');
                this.nextBtn = document.getElementById('nextBtn');

                // Controles de la barra de reproducción
                this.playerPlayBtn = document.getElementById('playerPlayBtn');
                this.playerLoopBtn = document.getElementById('playerLoopBtn');
                this.playerPrevBtn = document.getElementById('playerPrevBtn');
                this.playerNextBtn = document.getElementById('playerNextBtn');

                // Elementos de progreso
                this.progressBar = document.getElementById('progressBar');
                this.progressFill = document.getElementById('progressFill');
                this.currentTimeEl = document.getElementById('currentTime');
                this.totalTimeEl = document.getElementById('totalTime');

                // Elementos de la barra de reproducción
                this.playerProgressBar = document.getElementById('playerProgressBar');
                this.playerProgressFill = document.getElementById('playerProgressFill');
                this.playerCurrentTimeEl = document.getElementById('playerCurrentTime');
                this.playerTotalTimeEl = document.getElementById('playerTotalTime');

                // Controles de volumen
                this.volumeSlider = document.getElementById('volumeSlider');
                this.playerVolumeSlider = document.getElementById('playerVolumeSlider');

                // Información de la canción
                this.songTitleEl = document.getElementById('songTitle');
                this.artistNameEl = document.getElementById('artistName');
                this.albumArt = document.getElementById('albumArt');

                // Información de la barra de reproducción
                this.playerTrackTitle = document.getElementById('playerTrackTitle');
                this.playerTrackArtist = document.getElementById('playerTrackArtist');
                this.playerAlbumArt = document.getElementById('playerAlbumArt');

                // Estadísticas
                this.playCountEl = document.getElementById('playCount');
                this.playTimeEl = document.getElementById('playTime');
                this.statusEl = document.getElementById('status');
                this.playerContainer = document.getElementById('playerContainer');
            }

            attachEventListeners() {
                // Controles principales
                this.playBtn.addEventListener('click', () => this.togglePlay());
                this.loopBtn.addEventListener('click', () => this.toggleLoop());
                this.prevBtn.addEventListener('click', () => this.previousTrack());
                this.nextBtn.addEventListener('click', () => this.nextTrack());

                // Controles de la barra de reproducción
                this.playerPlayBtn.addEventListener('click', () => this.togglePlay());
                this.playerLoopBtn.addEventListener('click', () => this.toggleLoop());
                this.playerPrevBtn.addEventListener('click', () => this.previousTrack());
                this.playerNextBtn.addEventListener('click', () => this.nextTrack());

                // Progreso
                this.progressBar.addEventListener('click', (e) => this.seekTo(e));
                this.playerProgressBar.addEventListener('click', (e) => this.seekTo(e));

                // Volumen
                this.volumeSlider.addEventListener('input', (e) => {
                    this.audio.volume = e.target.value;
                    this.playerVolumeSlider.value = e.target.value;
                });

                this.playerVolumeSlider.addEventListener('input', (e) => {
                    this.audio.volume = e.target.value;
                    this.volumeSlider.value = e.target.value;
                });

                // Eventos de audio
                this.audio.addEventListener('loadedmetadata', () => this.updateDuration());
                this.audio.addEventListener('timeupdate', () => this.updateProgress());
                this.audio.addEventListener('ended', () => this.onSongEnd());
                this.audio.addEventListener('play', () => this.onPlay());
                this.audio.addEventListener('pause', () => this.onPause());
                this.audio.addEventListener('error', (e) => this.onError(e));

                // Eventos de ventana
                window.addEventListener('beforeunload', () => {
                    if (this.isPlaying && this.currentSong) {
                        this.savePlayProgress();
                    }
                });
            }

                    loadSong(songData) {
            // Guardar progreso de la canción anterior si está reproduciéndose
            if (this.isPlaying && this.currentSong) {
                this.audio.pause(); // Pausar primero para capturar el tiempo exacto
                this.savePlayProgress();
            }

            // Actualizar la canción actual
            this.currentSong = songData;
            this.audio.src = songData.streamingUrl;

            // Resetear el estado del reproductor
            this.hasStartedPlaying = false;
            this.totalPlayedTime = 0;
            this.currentSessionTime = 0;
            this.playCountRegistered = false;

            // Resetear elementos visuales
            this.statusEl.textContent = '';
            this.playTimeEl.textContent = '0:00';
            this.currentTimeEl.textContent = '0:00';
            this.playerCurrentTimeEl.textContent = '0:00';
            this.progressFill.style.width = '0%';
            this.playerProgressFill.style.width = '0%';

            // Actualizar información de la canción
            this.songTitleEl.textContent = songData.title;
            this.artistNameEl.textContent = songData.artistName;
            this.albumArt.textContent = songData.title.charAt(0).toUpperCase();
            this.playerTrackTitle.textContent = songData.title;
            this.playerTrackArtist.textContent = songData.artistName;
            this.playerAlbumArt.textContent = songData.title.charAt(0).toUpperCase();
            this.playCountEl.textContent = songData.playCount || '0'; // Manejo seguro del valor

            // Configurar volumen
            this.audio.volume = this.volumeSlider.value;
            this.playerVolumeSlider.value = this.volumeSlider.value;

            // Reiniciar controles de reproducción si estaba reproduciendo
            if (this.isPlaying) {
                this.isPlaying = false;
                this.playBtn.textContent = '▶️';
                this.playerPlayBtn.textContent = '▶️';
                this.playerContainer.classList.remove('playing');
            }
        }

            async togglePlay() {
                if (this.isPlaying) {
                    this.audio.pause();
                } else {
                    try {
                        await this.audio.play();
                    } catch (error) {
                        console.error('Error al reproducir:', error);
                        this.statusEl.textContent = 'Error al reproducir';
                    }
                }
            }

            toggleLoop() {
                this.isLooping = !this.isLooping;
                this.audio.loop = this.isLooping;

                // Actualizar botones de loop
                if (this.isLooping) {
                    this.loopBtn.classList.add('active');
                    this.playerLoopBtn.classList.add('active');
                    this.loopBtn.title = 'Desactivar repetición';
                    this.playerLoopBtn.title = 'Desactivar repetición';
                } else {
                    this.loopBtn.classList.remove('active');
                    this.playerLoopBtn.classList.remove('active');
                    this.loopBtn.title = 'Repetir canción';
                    this.playerLoopBtn.title = 'Repetir canción';
                }
            }

            previousTrack() {
                // Implementar navegación anterior
                this.statusEl.textContent = 'Función en desarrollo';
            }

            nextTrack() {
                // Implementar navegación siguiente
                this.statusEl.textContent = 'Función en desarrollo';
            }

            async savePlayProgress() {
            if (!this.currentSong || !this.audio || !this.isPlaying) return;

            const currentTime = Math.floor(this.audio.currentTime);
            const timePlayed = currentTime - this.currentSessionTime;

            // Solo registrar si hay al menos 1 segundo de reproducción
            if (timePlayed < 1) return;

            try {
                const response = await fetch(`/Songs/RecordPlay/${this.currentSong.id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({
                        DurationPlayedSeconds: timePlayed,
                        RegisterPlay: currentTime >= this.playTimeThreshold && !this.playCountRegistered
                    })
                });

                if (response.ok) {
                    const result = await response.json();

                    // Actualizar UI
                    this.totalPlayedTime += timePlayed;
                    this.playTimeEl.textContent = this.formatTime(this.totalPlayedTime);
                    this.currentSessionTime = currentTime;

                    if (result.countedAsPlay) {
                        this.playCountRegistered = true;
                        this.playCountEl.textContent = (parseInt(this.playCountEl.textContent) + 1).toString();
                    }
                } else {
                    console.error('Error en la respuesta:', await response.text());
                }
            } catch (error) {
                console.error('Error al guardar progreso:', error);
            }
        }

            seekTo(event) {
                if (!this.audio.duration) return;

                const rect = event.currentTarget.getBoundingClientRect();
                const percent = (event.clientX - rect.left) / rect.width;
                const newTime = percent * this.audio.duration;

                this.audio.currentTime = newTime;
                this.currentSessionTime = Math.floor(newTime);
            }

            updateProgress() {
            if (this.audio.duration) {
                const currentTime = this.audio.currentTime;
                const percent = (currentTime / this.audio.duration) * 100;

                // Actualizar barras de progreso
                this.progressFill.style.width = percent + '%';
                this.playerProgressFill.style.width = percent + '%';

                // Actualizar tiempos mostrados
                this.currentTimeEl.textContent = this.formatTime(currentTime);
                this.playerCurrentTimeEl.textContent = this.formatTime(currentTime);

                // Verificar si debemos contar como reproducción (10 segundos)
                if (currentTime >= this.playTimeThreshold && !this.playCountRegistered) {
                    this.savePlayProgress();
                }
            }
        }

            updateDuration() {
                if (this.audio.duration) {
                    this.totalTimeEl.textContent = this.formatTime(this.audio.duration);
                    this.playerTotalTimeEl.textContent = this.formatTime(this.audio.duration);
                }
            }

            formatTime(seconds) {
                if (!seconds || isNaN(seconds)) return '0:00';
                const mins = Math.floor(seconds / 60);
                const secs = Math.floor(seconds % 60);
                return `${mins}:${secs.toString().padStart(2, '0')}`;
            }

            onPlay() {
                this.isPlaying = true;
                this.playBtn.textContent = '⏸️';
                this.playerPlayBtn.textContent = '⏸️';
                this.playStartTime = Date.now();
                this.currentSessionTime = Math.floor(this.audio.currentTime);
                this.playerContainer.classList.add('playing');

                if (!this.hasStartedPlaying && this.currentSong) {
                    this.hasStartedPlaying = true;
                    this.statusEl.textContent = 'Reproduciendo...';
                }
            }

            onPause() {
                this.isPlaying = false;
                this.playBtn.textContent = '▶️';
                this.playerPlayBtn.textContent = '▶️';
                this.playerContainer.classList.remove('playing');

                // Guardar progreso al pausar
                if (this.currentSong) {
                    this.savePlayProgress();
                }
            }

            onSongEnd() {
                // Guardar progreso final
                if (this.currentSong) {
                    this.savePlayProgress();
                }

                if (!this.isLooping) {
                    this.isPlaying = false;
                    this.playBtn.textContent = '▶️';
                    this.playerPlayBtn.textContent = '▶️';
                    this.progressFill.style.width = '0%';
                    this.playerProgressFill.style.width = '0%';
                    this.currentTimeEl.textContent = '0:00';
                    this.playerCurrentTimeEl.textContent = '0:00';
                    this.currentSessionTime = 0;
                    this.playCountRegistered = false; // Reset para próxima reproducción
                    this.statusEl.textContent = 'Canción terminada';
                    this.playerContainer.classList.remove('playing');
                } else {
                    // En modo loop, reiniciar contadores
                    this.currentSessionTime = 0;
                    this.playCountRegistered = false;
                }
            }

            onError(error) {
                console.error('Error en el reproductor:', error);
                this.isPlaying = false;
                this.playBtn.textContent = '▶️';
                this.playerPlayBtn.textContent = '▶️';
                this.statusEl.textContent = 'Error al cargar la canción';
                this.playerContainer.classList.remove('playing');
            }
        }

        // Inicializar reproductor
        const player = new BeatBayPlayer();

        // Exponer API global
        window.BeatBayPlayer = {
            loadSong: (songData) => player.loadSong(songData)
        };
    </script>
</body>
</html>