@model BeatBay.DTOs.ResetPasswordDto
@{
    ViewData["Title"] = "Reset Password";
}

<style>
    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .reset-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .reset-card {
        background: rgba(248, 250, 252, 0.95);
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        width: 100%;
        max-width: 450px;
        overflow: hidden;
    }

    .reset-header {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: white;
        padding: 2rem;
        text-align: center;
        position: relative;
    }

        .reset-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.1);
            pointer-events: none;
        }

        .reset-header h4 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
            position: relative;
            z-index: 1;
        }

        .reset-header i {
            margin-right: 0.5rem;
            font-size: 1.2rem;
        }

    .reset-body {
        padding: 2rem;
    }

    .reset-description {
        color: #64748b;
        text-align: center;
        margin-bottom: 2rem;
        font-size: 0.95rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        color: #374151;
        font-weight: 500;
        margin-bottom: 0.5rem;
        display: block;
        font-size: 0.9rem;
    }

        .form-label i {
            color: #6366f1;
            margin-right: 0.5rem;
            width: 16px;
        }

    .form-control {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        background: white;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
            transform: translateY(-1px);
        }

        .form-control.is-invalid {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
        }

    .text-danger {
        color: #ef4444 !important;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .btn-primary {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        border: none;
        color: white;
        padding: 0.875rem 2rem;
        border-radius: 8px;
        font-weight: 500;
        font-size: 1rem;
        width: 100%;
        transition: all 0.3s ease;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.3);
            background: linear-gradient(135deg, #5855eb 0%, #7c3aed 100%);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn-primary i {
            margin-right: 0.5rem;
        }

    .reset-footer {
        background: rgba(248, 250, 252, 0.5);
        padding: 1.5rem;
        text-align: center;
        border-top: 1px solid rgba(226, 232, 240, 0.3);
    }

        .reset-footer small {
            color: #64748b;
            font-size: 0.85rem;
        }

        .reset-footer a {
            color: #6366f1;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
        }

            .reset-footer a:hover {
                color: #5855eb;
                text-decoration: none;
            }

            .reset-footer a i {
                margin-right: 0.25rem;
            }

    /* Responsive */
    @@media (max-width: 576px) {
        .reset-container

    {
        padding: 10px;
    }

    .reset-header,
    .reset-body,
    .reset-footer {
        padding: 1.5rem;
    }

    .reset-card {
        max-width: 100%;
    }

    }
</style>

<div class="reset-container">
    <div class="reset-card">
        <div class="reset-header">
            <h4><i class="fas fa-key"></i> Reset Password</h4>
        </div>
        <div class="reset-body">
            <p class="reset-description">Enter your new password below</p>
            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />
                <div class="form-group">
                    <label asp-for="NewPassword" class="form-label">
                        <i class="fas fa-lock"></i> New Password
                    </label>
                    <input asp-for="NewPassword" type="password" class="form-control"
                           placeholder="Enter your new password" required>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">
                        <i class="fas fa-lock"></i> Confirm Password
                    </label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control"
                           placeholder="Confirm your new password" required>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="form-group">
                    <button type="submit" class="btn-primary">
                        <i class="fas fa-check"></i> Reset Password
                    </button>
                </div>
            </form>
        </div>
        <div class="reset-footer">
            <small>
                Remember your password?
                <a asp-action="Login">
                    <i class="fas fa-sign-in-alt"></i> Login
                </a>
            </small>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Validación en tiempo real de coincidencia de passwords
            $('#ConfirmPassword').on('blur', function() {
                var password = $('#NewPassword').val();
                var confirmPassword = $(this).val();
                if (password !== confirmPassword && confirmPassword !== '') {
                    $(this).addClass('is-invalid');
                    $(this).next('.text-danger').text('Passwords do not match.');
                } else {
                    $(this).removeClass('is-invalid');
                    $(this).next('.text-danger').text('');
                }
            });
            // Mostrar/ocultar password
            $('.toggle-password').click(function() {
                var target = $($(this).data('target'));
                var type = target.attr('type') === 'password' ? 'text' : 'password';
                target.attr('type', type);
                $(this).find('i').toggleClass('fa-eye fa-eye-slash');
            });
        });
    </script>
}