@model BeatBay.DTOs.ForgotPasswordDto
@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }

    .forgot-password-container {
        position: relative;
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .card {
        border-radius: 20px;
        border: none;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        backdrop-filter: blur(10px);
        background: rgba(255, 255, 255, 0.95);
        max-width: 450px;
        width: 100%;
        overflow: hidden;
    }

    .card-header {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: white;
        text-align: center;
        padding: 30px 25px;
        border: none;
        position: relative;
    }

        .card-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(5px);
        }

        .card-header > * {
            position: relative;
            z-index: 1;
        }

        .card-header h3 {
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 1.5rem;
        }

        .card-header p {
            margin-bottom: 0;
            opacity: 0.9;
            font-size: 0.9rem;
        }

    .card-body {
        padding: 35px 30px;
        background: rgba(248, 250, 252, 0.05);
    }

    .alert-info {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(5, 150, 105, 0.05) 100%);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-left: 4px solid #10b981;
        color: #059669;
        border-radius: 12px;
        padding: 15px 18px;
        margin-bottom: 25px;
        font-size: 0.9rem;
    }

        .alert-info i {
            color: #10b981;
            margin-right: 8px;
        }

    .form-floating {
        margin-bottom: 20px;
        position: relative;
    }

        .form-floating > .form-control {
            padding-left: 3rem;
            border-radius: 12px;
            border: 2px solid rgba(99, 102, 241, 0.2);
            background: rgba(248, 250, 252, 0.8);
            font-size: 1rem;
            transition: all 0.3s ease;
            backdrop-filter: blur(5px);
        }

            .form-floating > .form-control:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
                background: rgba(255, 255, 255, 0.95);
            }

        .form-floating > label {
            padding-left: 3rem;
            color: #64748b;
            font-weight: 500;
        }

            .form-floating > label i {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: #6366f1;
                font-size: 1.1rem;
            }

    .btn-primary-custom {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        border: none;
        border-radius: 12px;
        padding: 14px 24px;
        font-size: 1.1rem;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
        position: relative;
        overflow: hidden;
    }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
            background: linear-gradient(135deg, #5855eb 0%, #7c3aed 100%);
        }

        .btn-primary-custom:active {
            transform: translateY(0);
        }

    .btn-outline-custom {
        border: 2px solid #6366f1;
        color: #6366f1;
        background: rgba(99, 102, 241, 0.05);
        border-radius: 12px;
        padding: 10px 20px;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

        .btn-outline-custom:hover {
            background: #6366f1;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
        }

    .divider {
        margin: 30px 0;
        border: none;
        height: 1px;
        background: linear-gradient(90deg, transparent 0%, rgba(99, 102, 241, 0.3) 50%, transparent 100%);
    }

    .text-center p {
        color: #64748b;
        margin-bottom: 15px;
        font-weight: 500;
    }

    .text-muted {
        color: #94a3b8 !important;
        font-size: 0.9rem;
    }

    .register-link {
        color: #10b981;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s ease;
    }

        .register-link:hover {
            color: #059669;
            text-decoration: none;
        }

    .text-danger {
        color: #ef4444 !important;
        font-size: 0.85rem;
        margin-top: 5px;
    }

    .validation-summary-errors {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        border-left: 4px solid #ef4444;
        color: #dc2626;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 20px;
    }

    /* Responsive adjustments */
    @@media (max-width: 576px) {
        .forgot-password-container

    {
        padding: 15px;
    }

    .card-body {
        padding: 25px 20px;
    }

    .card-header {
        padding: 25px 20px;
    }

    }
</style>

<div class="forgot-password-container">
    <div class="card shadow-lg">
        <div class="card-header">
            <h3><i class="fas fa-key"></i> Forgot Password</h3>
            <p>Don't worry, we'll help you reset it!</p>
        </div>
        <div class="card-body">
            <div class="alert alert-info" role="alert">
                <i class="fas fa-info-circle"></i>
                Enter your email address and we'll send you a link to reset your password.
            </div>
            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <div class="form-floating">
                    <input asp-for="Email" type="email" class="form-control" id="floatingEmail" placeholder="Email" />
                    <label for="floatingEmail"><i class="fas fa-envelope"></i> Email Address</label>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="fas fa-paper-plane"></i> Send Reset Link
                    </button>
                </div>
            </form>
            <hr class="divider">
            <div class="text-center">
                <p>Remember your password?</p>
                <a asp-action="Login" class="btn-outline-custom">
                    <i class="fas fa-sign-in-alt"></i> Back to Login
                </a>
            </div>
            <div class="text-center mt-3">
                <p class="text-muted">
                    Don't have an account?
                    <a asp-action="Register" class="register-link">Register here</a>
                </p>
            </div>
        </div>
    </div>
</div>
</div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}